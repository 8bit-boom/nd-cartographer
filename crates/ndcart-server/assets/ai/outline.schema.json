{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapOutline",
  "description": "The plan for a multi-floor map: floors, what each is for, how many rooms, and which floors connect. Rooms come in a second step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "floors"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "floors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "rooms"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rooms": { "type": "integer", "minimum": 1, "maximum": 20 },
          "links_to": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
        }
      }
    }
  }
}
