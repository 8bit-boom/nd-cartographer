{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditPlan",
  "description": "Typed edits to a painted floor. Every room id must be one the floor has; the studio checks that and turns the plan into one undoable step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["edits"],
  "properties": {
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "room", "name"],
            "properties": { "op": { "const": "rename_room" }, "room": { "type": "string" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 } }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "room", "lit"],
            "properties": { "op": { "const": "set_lit" }, "room": { "type": "string" }, "lit": { "type": "boolean" } }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "a", "b", "kind"],
            "properties": { "op": { "const": "set_link" }, "a": { "type": "string" }, "b": { "type": "string" }, "kind": { "enum": ["door", "opening", "secret"] } }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "room", "material"],
            "properties": { "op": { "const": "set_material" }, "room": { "type": "string" }, "material": { "type": "string" } }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "rooms"],
            "properties": { "op": { "const": "furnish" }, "rooms": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "room", "text"],
            "properties": { "op": { "const": "note" }, "room": { "type": "string" }, "text": { "type": "string", "minLength": 1, "maxLength": 200 } }
          }
        ]
      }
    }
  }
}
