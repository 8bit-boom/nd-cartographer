{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapSpec",
  "description": "A battle map as a room graph. Rules a schema cannot say: every room must be reachable from the first room of its floor through links; link ends and stair rooms must be room ids of the same floor; stairs lead to another floor by name; to_room must be a room id on that floor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "floors"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "floors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rooms"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "rooms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "w", "h"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                "kind": { "type": "string", "enum": ["room", "corridor", "area"] },
                "w": { "type": "integer", "minimum": 2, "maximum": 30 },
                "h": { "type": "integer", "minimum": 2, "maximum": 30 },
                "lit": { "type": "boolean" }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a", "b"],
              "properties": {
                "a": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
                "b": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
                "kind": { "type": "string", "enum": ["door", "opening", "secret"] }
              }
            }
          },
          "stairs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["room", "to_floor"],
              "properties": {
                "room": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
                "to_floor": { "type": "string" },
                "to_room": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
